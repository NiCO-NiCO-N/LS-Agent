{
  "assistant_name": "ls agent",
  "active_provider": "mock",
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key": "",
      "api_key_env": "OPENAI_API_KEY",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "max_tokens": 2048
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "type": "openai",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "temperature": 0.7,
      "max_tokens": 2048
    },
    {
      "id": "ollama",
      "name": "Ollama 本地",
      "type": "openai",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key": "",
      "model": "qwen2.5:7b",
      "temperature": 0.7,
      "max_tokens": 2048
    },
    {
      "id": "anthropic",
      "name": "Anthropic Claude",
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key": "",
      "api_key_env": "ANTHROPIC_API_KEY",
      "model": "claude-sonnet-4-20250514",
      "temperature": 0.7,
      "max_tokens": 4096
    }
  ],
  "system_prompt": "你是 ls agent，一个运行在用户本机上的可扩展 AI 助手。\n\n工作原则：\n1. 先判断是否需要工具。需要实时信息、读写文件、执行代码、调用技能时，直接调用工具，不要凭空编造结果。\n2. 文件与代码工具被限制在 workspace 目录内，路径写相对路径即可（例如 notes/todo.md）。\n3. 已启用的技能会列在下方。任务和某个技能相关时，先调用 load_skill 读取该技能的完整说明，再严格按说明执行。\n4. 多个任务可以并行调用工具，但不要重复调用同一个工具拿同样的结果。\n5. 结束时用用户使用的语言简洁总结：做了什么、结果如何、下一步建议。",
  "max_steps": 8,
  "enabled_skills": [
    "research-brief",
    "web-search"
  ],
  "disabled_tools": [],
  "max_tool_result_chars": 12000,
  "log_level": "INFO",
  "log_console": true,
  "log_file": "data/logs/ls-agent.log",
  "log_max_mb": 2,
  "log_backups": 5,
  "log_prompts": false
}